---
type Publication = {
    title: string;
    url?: string;
    authors: string;
    venue?: string;
    venueUrl?: string;
    slides?: string;
    website?: string;
    code?: string;
    summary?: string; // may contain inline HTML (links, <em>)
    selected?: boolean;
};

const publications: Publication[] = [
    {
        title: 'Attention via Black-Box Vector Search',
        url: 'https://arxiv.org/abs/2610.10135',
        authors: 'Alexandr Andoni, Krish Singal, Styopa Zharkov',
        selected: true,
    },
    {
        title: 'A Near-Optimal Space Lower Bound for Euclidean Diameter Estimation in Dynamic Streams',
        url: 'https://arxiv.org/abs/2609.19089',
        authors: 'Krish Singal, Erik Waingarten',
    },
    {
        title: "Prune, Don't Rebuild: Efficiently Tuning α-Reachable Graphs for Nearest Neighbor Search",
        url: 'https://arxiv.org/abs/2602.08097',
        authors: 'Zachary Ives, Jiaming Liang, Erik Waingarten, Tian Zhang',
        venue: 'NeurIPS 2026',
    },
    {
        title: 'VQ-bench: A Composable Vector Quantization Framework',
        url: 'https://arxiv.org/abs/2608.11240',
        authors: 'Amir Ingber, Edo Liberty',
        venue: 'VecDB@VLDB 2026',
        venueUrl: 'https://vecdb-ws.github.io/vldb2026/',
        slides: '/files/vqbench_slides_2026.pdf',
        website: 'https://vq-bench.com/',
        code: 'https://github.com/pinecone-io/vq-bench',
        summary:
            "Vector quantization is increasingly important for vector databases and LLMs, but state-of-the-art approaches are hard to compare. We propose a framework that expresses quantizers as compositions of shared primitives, making it easy to compare existing approaches and design new ones. We provide an <a href='https://github.com/pinecone-io/vq-bench' target='_blank' rel='noopener noreferrer'>open-source library</a> for building and evaluating quantizers, along with a public benchmark at <a href='https://vq-bench.com/' target='_blank' rel='noopener noreferrer'>vq-bench.com</a>.",
        selected: true,
    },
    {
        title: 'Learning Partition Trees for Nearest Neighbor Search',
        url: 'https://arxiv.org/abs/2607.09909',
        authors: 'Sanjeev Khanna, Erik Waingarten',
        venue: 'VecDB@VLDB 2026',
        venueUrl: 'https://vecdb-ws.github.io/vldb2026/',
        slides: '/files/learnpartitions_slides_2026.pdf',
        summary:
            "Can a nearest neighbor search index learn from past queries to answer future ones more efficiently? We give a positive answer: whenever queries follow a Gaussian-like distribution and the dataset admits a perfect halfspace partition tree, one can efficiently learn a data structure with sublinear query time.",
        selected: true,
    },
    {
        title: 'Sparse Navigable Graphs for Nearest Neighbor Search: Algorithms and Hardness',
        url: 'https://www.arxiv.org/abs/2507.14060',
        authors: 'Sanjeev Khanna, Erik Waingarten',
        venue: 'SODA 2026',
        venueUrl: 'https://epubs.siam.org/doi/10.1137/1.9781611978971.58',
        slides: '/files/navigability_slides_2025.pdf',
        summary:
        "Graph-based nearest neighbor search requires graphs that are simultaneously easy to navigate and sparse, but just how sparse can they be? We formulate constructing the sparsest navigable graph as a set covering problem, obtaining an O(<em>n</em><sup>3</sup>)-time approximation algorithm and matching hardness. We then introduce a relaxation of the problem which we solve via fast matrix multiplication.",
        selected: true,
    },
    {
        title: 'A Polynomial Space Lower Bound for Diameter Estimation in Dynamic Streams',
        url: 'https://arxiv.org/abs/2510.04918',
        authors: 'Sanjeev Khanna, Krish Singal, Erik Waingarten',
        venue: 'FOCS 2025',
        venueUrl: 'https://ieeexplore.ieee.org/stamp/stamp.jsp?arnumber=11369178',
    },
    {
        title: 'Inapproximability of Maximum Diameter Clustering for Few Clusters',
        url: 'https://arxiv.org/abs/2312.02097',
        authors: 'Karthik C. S., Henry Fleischmann, Kyrylo Karlov, Styopa Zharkov',
        venue: 'SODA 2025',
        venueUrl: 'https://epubs.siam.org/doi/10.1137/1.9781611978322.160',
    },
    {
        title: 'Smaller Low-Depth Circuits for Kronecker Powers',
        url: 'https://arxiv.org/abs/2211.05217',
        authors: 'Josh Alman, Yunfeng Guan',
        venue: 'SODA 2023',
        venueUrl: 'https://epubs.siam.org/doi/10.1137/1.9781611977554.ch160',
    },
];

const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="9Nk-1-VExk76wofq2iwLhm_6Hjs2Ycfu2gkl8wxVsJ8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ashwin Padaki</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9ELGBSH3P5"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-9ELGBSH3P5');
    </script>
</head>

<body class="bg-white text-neutral-800 antialiased">
    <main class="mx-auto max-w-[50rem] px-5 py-8 md:py-12 text-[15px] md:text-base leading-relaxed">
        <!-- Header -->
        <header class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
            <div>
                <h1 class="text-2xl md:text-3xl font-semibold tracking-tight text-neutral-900">Ashwin Padaki</h1>
                <p class="mt-1 font-mono font-medium text-[15px] text-[#474747] select-all">apadaki (at) engineering.upenn.edu</p>
            </div>
            <nav class="flex gap-5 text-base">
                <a class="icon-link" {...external} href="/files/Ashwin_Padaki_CV.pdf">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                        <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                        <path d="M16 13H8" />
                        <path d="M16 17H8" />
                        <path d="M10 9H8" />
                    </svg>
                    CV
                </a>
                <a class="icon-link" {...external} href="https://github.com/apadaki">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
                    </svg>
                    GitHub
                </a>
            </nav>
        </header>

        <!-- Profile Section -->
        <section class="mt-6 flex flex-col md:flex-row md:items-start gap-5 md:gap-8">
            <img
                src="./files/img/profile.jpg"
                class="w-32 md:w-40 shrink-0 self-center md:self-start rounded-md"
                alt=""
            />
            <div class="space-y-3">
                <p>
                    I am a Computer Science Ph.D. student at the <a class="link" {...external} href="https://theory.cis.upenn.edu/people/">University of Pennsylvania</a>, where I am lucky to be advised by <a class="link" {...external} href="https://sites.google.com/site/erikwaing/home/">Erik Waingarten</a> and <a class="link" {...external} href="https://sanjeevkhanna.org/">Sanjeev Khanna</a>. I use ideas and tools from theoretical computer science to better understand problems that arise in machine learning and search systems, such as <em>nearest neighbor search</em>, <em>quantization</em>, and <em>attention</em>. My overarching goal is to develop algorithmic approaches that are theoretically principled while aligning with the constraints and objectives of real-world systems.
                </p>
                <p>
                    In summer 2026, I interned at <a class="link" {...external} href="https://www.pinecone.io/">Pinecone</a>, hosted by <a class="link" {...external} href="https://scholar.google.com/citations?user=0IkkBzQAAAAJ&hl=en">Amir Ingber</a> and <a class="link" {...external} href="https://edoliberty.com/">Edo Liberty</a>. We developed and maintain <a class="link" {...external} href="https://vq-bench.com/">VQ-bench</a>, an open-source benchmark for vector quantization.
                </p>
                <p>
                    My research is supported by an
                    <a class="link" {...external} href="https://www.nsfgrfp.org/">NSF Graduate Research Fellowship</a>.
                </p>
            </div>
        </section>

        <!-- Publications -->
        <section class="mt-10">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 border-b border-neutral-200 pb-2">
                <h2 class="text-lg font-semibold text-neutral-900">Papers</h2>
                <div class="publication-toggle flex items-center gap-1.5 text-base" role="group" aria-label="Paper filter">
                    <button type="button" data-publication-filter="selected" aria-pressed="true" aria-controls="publications">Selected</button>
                    <span class="text-neutral-400" aria-hidden="true">/</span>
                    <button type="button" data-publication-filter="all" aria-pressed="false" aria-controls="publications">All</button>
                </div>
            </div>
            <ul id="publications" class="mt-4 space-y-4">
                {publications.map((pub, i) => (
                    <li hidden={!pub.selected} data-selected={pub.selected ? '' : undefined}>
                        {pub.url
                            ? <a class="font-medium text-neutral-900 hover:underline underline-offset-2" {...external} href={pub.url}>{pub.title}</a>
                            : <span class="font-medium text-neutral-900">{pub.title}</span>}
                        <div class="text-[#474747]">with {pub.authors}</div>
                        {(pub.venue || pub.slides || pub.website || pub.code || pub.summary) && (
                            <div class="text-[15px] text-neutral-500">
                                {[
                                    pub.venue && (pub.venueUrl
                                        ? <a class="venue meta-link" {...external} href={pub.venueUrl}>{pub.venue}</a>
                                        : <span class="venue">{pub.venue}</span>),
                                    pub.slides && <a class="resource meta-link" {...external} href={pub.slides}>slides</a>,
                                    pub.website && <a class="resource meta-link" {...external} href={pub.website}>website</a>,
                                    pub.code && <a class="resource meta-link" {...external} href={pub.code}>code</a>,
                                ].filter(Boolean).map((item, j) => <>{j > 0 && <span aria-hidden="true"> · </span>}{item}</>)}
                                {pub.summary && (
                                    <button type="button" class="summary-toggle" data-summary-toggle aria-expanded="false" aria-controls={`summary-${i}`} aria-label="Show summary">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m6 9 6 6 6-6" />
                                        </svg>
                                    </button>
                                )}
                            </div>
                        )}
                        {pub.summary && (
                            <p id={`summary-${i}`} class="summary mt-2 rounded-md bg-red-50 px-3 py-2 text-[15px] text-neutral-800" hidden set:html={pub.summary} />
                        )}
                    </li>
                ))}
            </ul>
            <p class="mt-5 text-sm text-neutral-500">By convention, co-authors are listed alphabetically by last name.</p>
        </section>

        <!-- Other Section -->
        <section class="mt-10">
            <h2 class="text-lg font-semibold text-neutral-900 border-b border-neutral-200 pb-2">Other</h2>
            <ul class="mt-4 list-disc pl-5 space-y-1 marker:text-neutral-400">
                <li>
                    Before Penn, I studied Math and Computer Science at <a class="link" {...external} href="https://theory.cs.columbia.edu/">Columbia University</a>.
                    I was fortunate to have amazing mentors in
                    <a class="link" {...external} href="https://joshalman.com/">Josh Alman</a>,
                    <a class="link" {...external} href="https://cskarthikcs.github.io/">Karthik C. S.</a>,
                    and
                    <a class="link" {...external} href="https://www.cs.columbia.edu/~rocco/">Rocco Servedio</a>.
                </li>
                <li>Years ago, I interned as a quantitative trader at <a class="link" {...external} href="https://optiver.com/">Optiver</a>, an options market-making firm in Chicago.</li>
                <li>Outside of research, I like playing soccer and tennis, going on long walks and hikes, making music, and experimenting with wordplay.</li>
            </ul>
        </section>
    </main>
</body>
</html>

<style>
    .link {
        color: #0284c7;
        font-weight: 500;
        text-underline-offset: 2px;
    }

    .link:hover {
        text-decoration: underline;
    }

    .venue {
        color: #0f9e8a;
        font-weight: 500;
    }

    .venue.meta-link:hover {
        color: #0b7a6b;
    }

    .resource {
        color: #0284c7;
    }

    .meta-link:hover {
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .summary :global(a) {
        color: #404040;
        font-weight: 500;
        text-underline-offset: 2px;
    }

    .summary :global(a:hover) {
        color: #171717;
        text-decoration: underline;
    }

    .summary-toggle {
        display: inline-flex;
        vertical-align: middle;
        margin-left: 0.375rem;
        padding: 2px;
        border-radius: 2px;
        color: #737373;
        transition: color 150ms;
    }

    .summary-toggle:hover {
        color: #171717;
    }

    .summary-toggle:focus-visible {
        outline: 2px solid #0284c7;
        outline-offset: 1px;
    }

    .summary-toggle svg {
        width: 0.875rem;
        height: 0.875rem;
        transition: transform 150ms;
    }

    .summary-toggle[aria-expanded="true"] svg {
        transform: rotate(180deg);
    }

    .icon-link {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        color: #525252;
        transition: color 150ms;
    }

    .icon-link:hover {
        color: #171717;
    }

    .icon-link svg {
        width: 1.125rem;
        height: 1.125rem;
    }

    .publication-toggle button {
        color: #8f8f8f;
        transition: color 150ms;
    }

    .publication-toggle button[aria-pressed="true"] {
        color: #171717;
        font-weight: 500;
    }

    .publication-toggle button:hover {
        color: #404040;
    }

    .publication-toggle button:focus-visible {
        outline: 2px solid #0284c7;
        outline-offset: 2px;
        border-radius: 2px;
    }
</style>

<script>
    const publicationFilters = document.querySelectorAll<HTMLButtonElement>('[data-publication-filter]');
    const publications = document.querySelectorAll<HTMLLIElement>('#publications > li');

    document.querySelectorAll<HTMLButtonElement>('[data-summary-toggle]').forEach((button) => {
        const summary = document.getElementById(button.getAttribute('aria-controls') ?? '');

        button.addEventListener('click', () => {
            const expanded = button.getAttribute('aria-expanded') === 'true';
            button.setAttribute('aria-expanded', String(!expanded));
            button.setAttribute('aria-label', expanded ? 'Show summary' : 'Hide summary');
            if (summary) summary.hidden = expanded;
        });
    });

    publicationFilters.forEach((button) => {
        button.addEventListener('click', () => {
            const showAll = button.dataset.publicationFilter === 'all';

            publicationFilters.forEach((filter) => {
                filter.setAttribute('aria-pressed', String(filter === button));
            });

            publications.forEach((publication) => {
                publication.hidden = !showAll && !publication.hasAttribute('data-selected');
            });
        });
    });
</script>
